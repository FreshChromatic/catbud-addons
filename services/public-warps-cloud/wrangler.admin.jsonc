{
  "name": "control",
  "main": "src/management-worker.mjs",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "admin",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catbud-public-warps",
      "database_id": "27a2016a-6b97-409d-87c9-f28b4d021c1e",
    },
  ],
  "vars": {
    "POSTING_ENABLED": "true",
    "DATABASE_SOFT_LIMIT_BYTES": "350000000",
    "DATABASE_HARD_LIMIT_BYTES": "400000000",
  },
}
